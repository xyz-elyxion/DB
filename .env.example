# Bot token from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=

# The server people use (everything here is copied from it)
SOURCE_GUILD_ID=

# The preview server (everything is copied into it)
TARGET_GUILD_ID=

# Set to true to mirror messages too. Requires the privileged "Message Content"
# intent to be enabled for the bot in the Developer Portal.
ENABLE_MESSAGE_CONTENT=false

# Optional: enables the #join-server button that moves people into the real
# server. Copy it from Developer Portal -> OAuth2 -> Client Secret, and add
# <PUBLIC_URL>/join/callback to that page's Redirects.
CLIENT_SECRET=

# Every domain the bot answers the join callback on (comma or space separated).
# Register each one under Developer Portal -> OAuth2 -> Redirects, as
# <domain>/join/callback. The bot gives the embed one button per domain.
PUBLIC_URLS=https://45tapl8dqb.apps.bot-hosting.cloud,https://limey-discord.apps.bot-hosting.cloud

# Moderation log channel (optional). Without it the bot uses a #mod-logs channel.
MOD_LOG_CHANNEL_ID=

# Where warnings and case numbers are stored (optional, default data/moderation.json).
CASES_FILE=data/moderation.json

# Personal preview invites (optional, default data/invites.json).
INVITES_FILE=data/invites.json

# People blocked from joining the real server via the preview (default data/join-blocks.json).
JOIN_BLOCKS_FILE=data/join-blocks.json

# Levelling (optional). XP per message, and how often a member can earn it.
# Stored in LEVELS_FILE (default data/levels.json).
XP_MIN_PER_MESSAGE=15
XP_MAX_PER_MESSAGE=25
XP_COOLDOWN_SECONDS=60
LEVELS_FILE=data/levels.json

# Member join events, needed to enforce one-person invites. Turn off only if you
# cannot enable the Server Members intent in the Developer Portal.
ENABLE_MEMBER_INTENTS=true

# Local port the redirect listener binds to (both domains must reach it).
SERVER_PORT=3000
# PORT is still accepted if SERVER_PORT is not set.
