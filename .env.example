# Bot token from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=

# Optional: application (client) ID. Not normally needed — it is looked up from
# the token. Only used as a fallback if that lookup fails.
CLIENT_ID=

# Optional: register slash commands instantly in this one server while developing.
# Leave empty to register them globally (Discord can take up to an hour to show them).
GUILD_ID=

# Set to true to allow copying recent messages. Requires the privileged
# "Message Content" intent to be enabled for the bot in the Developer Portal.
ENABLE_MESSAGE_CONTENT=false
